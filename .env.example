# =============================================================================
# Jaymurti Traders — Environment Variables Template
# =============================================================================

# --- Deployment Mode ---
# Set to 'true' for standalone client demo deployment (Render/Railway) without requiring MySQL or OAuth
DEMO_MODE=false

# --- Mandatory Production Variables (Required for full production when DEMO_MODE=false) ---
# MySQL connection string (e.g. TiDB Cloud / PlanetScale / Aiven / AWS RDS / Render MySQL)
# Format: mysql://<user>:<password>@<host>:<port>/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Cryptographically secure random secret (min 32 characters) for HS256 JWT cookie session signing
JWT_SECRET=

# OAuth identity provider base URL for administrative and user authentication
OAUTH_SERVER_URL=

# Registered OAuth Application / Client ID for this site
VITE_APP_ID=

# --- Administrator Access Configuration ---
# The OAuth OpenID of the store owner/admin to grant administrative permissions (review moderation)
OWNER_OPEN_ID=

# Optional fallback secret header key (min 8 chars) for direct admin API access via 'x-admin-key'
ADMIN_KEY=

# --- Server Tuning & Infrastructure (Render automatically sets PORT) ---
PORT=3000
DB_POOL_SIZE=10
DB_QUERY_TIMEOUT_MS=5000

# --- Optional Integrations ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional Render Deploy Hook (used by 'npm run deploy' to trigger instant deployments)
RENDER_DEPLOY_HOOK_URL=
